# ============================================================
#  Chifa Wok - Voice AI Business Assistant
#  Copia este archivo como .env  ->  cp .env.example .env
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=chifawok
POSTGRES_USER=chifawok
POSTGRES_PASSWORD=chifawok
POSTGRES_HOST=db
# Puerto en el HOST. Se usa 5434 para NO chocar con un PostgreSQL local en 5432.
# El contenedor db crea el usuario/base 'chifawok' automaticamente.
POSTGRES_PORT=5434

# ---- Backend (Spring Boot) ----
BACKEND_PORT=8080
JWT_SECRET=cambia-esta-clave-por-una-de-al-menos-32-caracteres-super-secreta
JWT_EXPIRATION_MINUTES=120
AI_SERVICE_BASE_URL=http://ai-service:8001

# Solo para 'mvn spring-boot:run' en local (Spring SI lee estas variables del entorno).
# Con Docker no hacen falta: el compose las inyecta apuntando al servicio 'db'.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/chifawok
SPRING_DATASOURCE_USERNAME=chifawok
SPRING_DATASOURCE_PASSWORD=chifawok
APP_JWT_SECRET=clave-de-desarrollo-cambiala-en-produccion-con-32-o-mas-caracteres
APP_AI_BASE_URL=http://localhost:8001
APP_CORS_ORIGINS=http://localhost:4200

# ---- Microservicio de IA (FastAPI + LangChain) ----
AI_SERVICE_PORT=8001
# Proveedor LLM: openai | anthropic | fake  (fake = sin API key, extraccion por reglas)
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Frontend (Angular) ----
FRONTEND_PORT=4200
API_BASE_URL=http://localhost:8080/api
