# ============================================================
#  Chifa Wok - Voice AI Business Assistant
#  Copia este archivo como .env y ajusta los valores.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=chifawok
POSTGRES_USER=chifawok
POSTGRES_PASSWORD=chifawok
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Backend (Spring Boot) ----
BACKEND_PORT=8080
JWT_SECRET=cambia-esta-clave-por-una-de-al-menos-32-caracteres-super-secreta
JWT_EXPIRATION_MINUTES=120
AI_SERVICE_BASE_URL=http://ai-service:8001

# ---- Microservicio de IA (FastAPI + LangChain) ----
AI_SERVICE_PORT=8001
# Proveedor LLM: openai | anthropic | fake  (fake = sin API key, respuestas simuladas)
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Frontend (Angular) ----
FRONTEND_PORT=4200
API_BASE_URL=http://localhost:8080/api
